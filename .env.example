# The production URL of the site, used for canonical links, sitemap.xml,
# robots.txt, and Open Graph/Twitter metadata. Set this in Vercel's
# Project Settings -> Environment Variables once the custom domain is live.
NEXT_PUBLIC_SITE_URL=https://www.cristalux.com

# --- Catalogue flipbook (/catalogue) ---
# The password required to publish a new catalogue (paste a Google Drive PDF
# link into the "Update catalogue" form). Pick your own value.
CATALOGUE_ADMIN_PASSWORD=change-me

# Where the published catalogue link is stored, so every visitor sees the same
# book. In Vercel: Storage -> Create Database -> Upstash for Redis, connected
# to this project - it injects KV_REST_API_URL / KV_REST_API_TOKEN
# automatically, nothing to copy by hand. The UPSTASH_REDIS_REST_* names below
# work too. Leave empty for local development (.data/catalogue.json is used).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where the pre-rendered catalogue page images are stored, so visitors load
# small images instead of the whole PDF. In Vercel: Storage -> Create -> Blob,
# connected to this project - it injects this automatically. Leave empty for
# local development (images are written to .data/catalogue-pages/).
BLOB_READ_WRITE_TOKEN=
